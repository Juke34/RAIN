Bootstrap: docker
From: ghcr.io/prefix-dev/pixi:0.81.0

%files
    containers/common/barometer/pixi.toml /app/pixi.toml
    containers/common/barometer/pixi.lock /app/pixi.lock
    bin/barometer_beta_binomial.R /opt/rain/barometer_beta_binomial.R

%environment
    export RAIN_BETA_BINOMIAL_SCRIPT=/opt/rain/barometer_beta_binomial.R

%post
    cd /app
    pixi install --locked
    ln -sf /app/.pixi/envs/default/bin/* /usr/local/bin/
    Rscript -e 'library(glmmTMB)'

%runscript
    exec bash "$@"

%labels
    Author eascarrunz.dev@mailfence.com
    Tool Barometer beta-binomial analysis