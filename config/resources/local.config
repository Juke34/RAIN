process {
    cpus = 1
    time = '1h'
    maxForks = 8
    shell = ['/bin/bash', '-euo', 'pipefail']
    stageOutMode = 'rsync'
    
    withLabel: 'agat' {
        cpus = 1
        memory = "2G"
        time = '1d'
    }
    withLabel: 'aline' {
        cpus = 4
        time = '2d'
    }
    withLabel: 'bamutil' {
        cpus = 1
        time = '1d'
        memory="12G"
    }
    withName: 'barometer_analyze' {
        cpus = 2
        time = '6h'
    }
    withName: 'barometer_report' {
        cpus = 1
        time = '6h'
    }
    withName: 'drip' {
        cpus = 2
        time = '6h'
    }
    withLabel: 'fastqc' {
        cpus = 2
        time = '6h'
    }
    withName: 'fastp' {
        cpus = 2
        time = '1d'
    }    
    withLabel: 'gatk' {
        cpus = 1
        time = '1d'
    }
    withLabel: 'jacusa2' {
        cpus = 4
        memory = "4G"
        time = '1d'
    }
    withLabel: 'hisat2_index' {
        cpus = 4
        time = '1h'
    }
    withLabel: 'hisat2' {
        cpus = 6
        time = '1d'
    }
    withName: 'pluviometer' {
        cpus = 2
        time = '6h'
    }    
    withLabel: 'reditools3' {
        cpus = 2
        time = '1d'
        memory="4G"
    }
    withName: 'restore_original_sequences' {
        cpus = 1
        time = '6h'
    }
    withLabel: 'samtools' {
        cpus = 2
        time = '1d'
    }
}
